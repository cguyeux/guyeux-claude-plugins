{
  "description": "Hooks personnels Codex portes depuis Claude Code pour CCX-07.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/christophe/docs/codes/claude_plugins/codex_hooks/scripts/session_context.py",
            "statusMessage": "Chargement du contexte projet (etat + pistes + cahier)...",
            "additionalContextLimit": 5000,
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/christophe/docs/codes/claude_plugins/codex_hooks/scripts/no_rm_guard.py",
            "statusMessage": "Garde-fou suppression (rm interdit, gio trash obligatoire)...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 /home/christophe/docs/codes/claude_plugins/codex_hooks/scripts/remote_compute_reminder.py",
            "statusMessage": "Rappel calcul distant (mp / mh)...",
            "additionalContextLimit": 1200,
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/christophe/docs/codes/claude_plugins/codex_hooks/scripts/precompute_reminder.py",
            "statusMessage": "Rappel pré-calcul (lit-review + cahier + pistes + challenge)...",
            "additionalContextLimit": 1200,
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/christophe/docs/codes/claude_plugins/codex_hooks/scripts/stop_guard.py",
            "statusMessage": "Contrôle de fin de session (pistes, état, cahier)...",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
