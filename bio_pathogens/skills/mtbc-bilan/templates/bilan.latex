%% Pandoc LaTeX template for MTBC project bilans
%% Produces a clean, readable PDF with professional typography
\documentclass[11pt,a4paper]{article}

% French language support
\usepackage{polyglossia}
\setmainlanguage{french}

% Encoding and fonts
\usepackage{fontspec}
\setmainfont{Latin Modern Roman}
\setsansfont{Latin Modern Sans}
\setmonofont{Latin Modern Mono}

% Page layout
\usepackage[margin=2.5cm, top=3cm, bottom=3cm]{geometry}

% Colors
\usepackage{xcolor}
\definecolor{accent}{HTML}{2C5F8A}
\definecolor{lightgray}{HTML}{F5F5F5}
\definecolor{darkgray}{HTML}{333333}
\definecolor{midgray}{HTML}{666666}
\definecolor{verdictgreen}{HTML}{2E7D32}
\definecolor{verdictorange}{HTML}{E65100}
\definecolor{verdictred}{HTML}{B71C1C}

% Headers and footers
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\textcolor{midgray}{$if(project)$$project$$endif$}}
\fancyhead[R]{\small\textcolor{midgray}{$date$}}
\fancyfoot[C]{\small\textcolor{midgray}{\thepage}}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

% Section styling
\usepackage{titlesec}
\titleformat{\section}
  {\Large\bfseries\color{accent}}
  {\thesection.}{0.5em}{}
  [\vspace{-0.5em}\textcolor{accent}{\rule{\textwidth}{0.5pt}}]
\titleformat{\subsection}
  {\large\bfseries\color{darkgray}}
  {\thesubsection.}{0.5em}{}
\titleformat{\subsubsection}
  {\normalsize\bfseries\color{darkgray}}
  {\thesubsubsection.}{0.5em}{}
\titlespacing*{\section}{0pt}{1.5em}{0.8em}
\titlespacing*{\subsection}{0pt}{1em}{0.5em}

% Blockquote styling (used for verdict)
\usepackage{tcolorbox}
\tcbuselibrary{breakable,skins}
\newtcolorbox{verdict}{
  colback=lightgray,
  colframe=accent,
  boxrule=0pt,
  leftrule=4pt,
  arc=0pt,
  breakable,
  top=8pt, bottom=8pt, left=12pt, right=12pt,
  fontupper=\large
}

% Redefine blockquote environment for pandoc
\renewenvironment{quote}
  {\begin{verdict}}
  {\end{verdict}}

% Pedagogical callout boxes
% Used to explain domain concepts that a reader with a pure-math / basic-CS
% background would not be expected to know (ethnolinguistics, population
% genetics, evolutionary biology, advanced statistics, phylogenetic methods).
\definecolor{notioncolor}{HTML}{1565C0}      % Concept de domaine (bleu)
\definecolor{methodecolor}{HTML}{2E7D32}     % Technique stats/algo (vert)
\definecolor{originalitecolor}{HTML}{6A1B9A} % Originalite/nouveaute (violet)
\definecolor{remarquablecolor}{HTML}{C77700} % Resultat remarquable (ambre)

\newtcolorbox{notion}[1][Notion]{
  enhanced, breakable,
  colback=notioncolor!4, colframe=notioncolor,
  fonttitle=\sffamily\bfseries,
  title={Notion --- #1},
  coltitle=white, colbacktitle=notioncolor,
  boxrule=0pt, arc=2pt,
  top=8pt, bottom=8pt, left=10pt, right=10pt,
  before skip=10pt, after skip=10pt
}

\newtcolorbox{methode}[1][Methode]{
  enhanced, breakable,
  colback=methodecolor!4, colframe=methodecolor,
  fonttitle=\sffamily\bfseries,
  title={Methode --- #1},
  coltitle=white, colbacktitle=methodecolor,
  boxrule=0pt, arc=2pt,
  top=8pt, bottom=8pt, left=10pt, right=10pt,
  before skip=10pt, after skip=10pt
}

\newtcolorbox{originalite}[1][Originalite]{
  enhanced, breakable,
  colback=originalitecolor!4, colframe=originalitecolor,
  fonttitle=\sffamily\bfseries,
  title={En quoi c'est nouveau --- #1},
  coltitle=white, colbacktitle=originalitecolor,
  boxrule=0pt, arc=2pt,
  top=8pt, bottom=8pt, left=10pt, right=10pt,
  before skip=10pt, after skip=10pt
}

\newtcolorbox{remarquable}[1][Resultat remarquable]{
  enhanced, breakable,
  colback=remarquablecolor!4, colframe=remarquablecolor,
  fonttitle=\sffamily\bfseries,
  title={Pourquoi c'est remarquable --- #1},
  coltitle=white, colbacktitle=remarquablecolor,
  boxrule=0pt, arc=2pt,
  top=8pt, bottom=8pt, left=10pt, right=10pt,
  before skip=10pt, after skip=10pt
}

% Tables
\usepackage{calc}
\usepackage{booktabs}
\usepackage{longtable}
\usepackage{array}
% Pandoc longtable column width support
\providecommand{\real}[1]{#1}
\renewcommand{\arraystretch}{1.3}

% Links
\usepackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=accent,
  urlcolor=accent,
  citecolor=accent,
  pdfauthor={Christophe Guyeux},
  pdftitle={$title-meta$}
}

% Lists
\usepackage{enumitem}
\setlist[itemize]{itemsep=0.2em, parsep=0.1em}
\setlist[enumerate]{itemsep=0.2em, parsep=0.1em}

% Code blocks
\usepackage{listings}
\lstset{
  basicstyle=\small\ttfamily,
  backgroundcolor=\color{lightgray},
  frame=none,
  breaklines=true,
  xleftmargin=1em,
  xrightmargin=1em,
  aboveskip=0.5em,
  belowskip=0.5em
}

% Paragraphs
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.6em}

% Tight list fix for pandoc
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0.2em}\setlength{\parskip}{0pt}}

% TikZ for title page and pipeline diagrams
\usepackage{tikz}
\usetikzlibrary{arrows.meta, positioning, shapes.geometric, fit, calc,
                decorations.pathreplacing, patterns, backgrounds,
                shapes.misc, shadows.blur}
% pgfplots for charts and simple maps (bubble plots over coordinates)
\usepackage{pgfplots}
\pgfplotsset{compat=1.18}
% Graphics inclusion (for reusing article figures)
\usepackage{graphicx}
\graphicspath{{../article/figures/}{../resultats/}{./figures/}{./}}

\begin{document}

% Custom title
\begin{titlepage}
\begin{tikzpicture}[remember picture,overlay]
  \fill[accent] (current page.north west) rectangle
    ([yshift=-6cm]current page.north east);
  \node[anchor=west, white, font=\Huge\bfseries, text width=14cm]
    at ([yshift=-2.5cm, xshift=2.5cm]current page.north west)
    {$title$};
  \node[anchor=west, white!80, font=\Large, text width=14cm]
    at ([yshift=-4.2cm, xshift=2.5cm]current page.north west)
    {$if(subtitle)$$subtitle$$endif$};
\end{tikzpicture}

\vspace{7cm}

{\large
\begin{tabular}{@{}ll@{}}
$if(project)$\textbf{Projet} & $project$ \\$endif$
$if(lineage)$\textbf{Lignée MTBC} & $lineage$ \\$endif$
\textbf{Responsable} & Christophe Guyeux (FEMTO-ST) \\
\textbf{Date} & $date$ \\
$if(verdict)$\textbf{Verdict} & $verdict$ \\$endif$
\end{tabular}
}

\vfill

{\small\textcolor{midgray}{Généré automatiquement par /mtbc-bilan — Plugin bio}}

\end{titlepage}

\tableofcontents
\newpage

$body$

\end{document}
